      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $root = WP_CONTENT_DIR . '/uploads/vwvs-playground'; $settings = VWvideoShare::getOptions(); $settings['custom_post'] = 'video'; $settings['custom_taxonomy'] = 'playlist'; $settings['uploadsPath'] = $root; $settings['uploadsURL'] = content_url( '/uploads/vwvs-playground/' ); $settings['thumbWidth'] = '240'; $settings['thumbHeight'] = '180'; $settings['perPage'] = '8'; $settings['perRow'] = '3'; $settings['listingsMenu'] = '0'; $settings['rateStarReview'] = '0'; $settings['enable_exec'] = '0'; $settings['disableSetupPages'] = '0'; $settings['playgroundDemo'] = '1'; update_option( 'VWvideoShareOptions', $settings ); VWvideoShare::video_post(); VWvideoShare::setupPages(); VWvideoShare::setupPlaygroundDemo(); if ( ! post_type_exists( 'video' ) || ! taxonomy_exists( 'playlist' ) ) { throw new RuntimeException( 'Video Share VOD post type or taxonomy was not registered.' ); } $items = array( 'alpine-cabin', 'pottery-workshop', 'snowboard-descent', 'mountain-bike-trail', 'kiteboarding-sunset', 'dance-studio', 'cats-at-play', 'standup-show' ); foreach ( $items as $item ) { $thumbnail = $root . '/_thumbs/' . $item . '.jpg'; $preview = $root . '/_previews/' . $item . '.jpg'; if ( ! is_readable( $thumbnail ) || ! is_readable( $preview ) ) { throw new RuntimeException( 'A required VOD demo asset is missing: ' . $item ); } $posts = get_posts( array( 'post_type' => 'video', 'post_status' => 'any', 'posts_per_page' => 1, 'meta_key' => 'vwvs_playground_demo_key', 'meta_value' => $item, 'fields' => 'ids' ) ); if ( ! $posts ) { throw new RuntimeException( 'A required VOD demo record is missing: ' . $item ); } } ?>"
