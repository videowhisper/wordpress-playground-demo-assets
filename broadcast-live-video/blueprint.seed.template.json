{
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "videowhisper-live-streaming-integration"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/vwls-playground/_thumbs"
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/vwls-playground/_previews"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/vwls-playground/_thumbs/Offline-Podcast-Studio.jpg",
      "data": { "resource": "url", "url": "__ASSET_BASE_URL__/broadcast-live-video/images/thumbnails/podcast-studio.jpg" }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/vwls-playground/_thumbs/Offline-Live-Event.jpg",
